# AEROLOG — local development configuration
# Replace the empty quotes with your values, keeping the quotes.
# Example: SUPABASE_PROJECT_NAME="aerolog-development"
# This blank example is safe to commit. Keep actual values only in .env.local.
# Values are used by the local app. Deployment configuration will be handled later.
# NEXT_PUBLIC_ values are browser-visible. Never put secret keys in those fields.

# ── APPLICATION ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_PRODUCTION_URL="https://aerolog-drone-operations.info-ada6.chatgpt.site"
APP_NAME="AEROLOG"
APP_COMPANY_NAME=""
APP_ADMIN_EMAIL=""
APP_TIMEZONE="Asia/Dubai"
APP_OPERATING_COUNTRIES=""
# Optional: preferred custom domain, without https://
APP_CUSTOM_DOMAIN=""

# ── SUPABASE: APPLICATION CONNECTION ─────────────────────────────────
# Project name is your dashboard label. Project ID is the reference string.
SUPABASE_PROJECT_NAME=""
SUPABASE_PROJECT_ID=""
# Example: https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Browser-safe publishable key, starting sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Backend only: secret key, starting sb_secret_
SUPABASE_SECRET_KEY=""
# Region selected when creating the project (informational).
SUPABASE_REGION=""

# ── SUPABASE: DEVELOPMENT / MIGRATIONS ONLY ───────────────────────────
# Personal access token for the Supabase CLI / Management API.
# May remain empty if the CLI is already authenticated locally.
# These two values must NOT be deployed as application runtime settings.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# ── DJI ──────────────────────────────────────────────────────────────
# Copy the exact API/application type from the DJI developer dashboard.
# Example: Open API (flight-record parsing) or Cloud API.
DJI_API_TYPE=""
DJI_APP_KEY=""
# Optional: fill only if DJI provides these for the selected API type.
DJI_APP_ID=""
DJI_APP_SECRET=""
DJI_APP_LICENSE=""
# Non-secret integration details. No pilot passwords are needed here.
DJI_API_DOCUMENTATION_URL=""
DJI_ACCOUNT_REGION=""
# Comma-separated names, e.g. Matrice 350 RTK,Mavic 3 Enterprise
DJI_AIRCRAFT_MODELS=""
DJI_CONTROLLER_MODELS=""
# e.g. DJI Pilot 2,DJI Fly,DJI GO 4
DJI_PILOT_APPS=""
# Optional: local folder containing sample flight logs for integration testing.
DJI_SAMPLE_LOGS_DIRECTORY=""

# ── MAPBOX ───────────────────────────────────────────────────────────
# Public pk. token with styles:read and fonts:read scopes.
# Local token: allow http://localhost:3000 in its URL restrictions.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Public production token, restricted to APP_PRODUCTION_URL / custom domain.
# Deployment will map this to NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN.
MAPBOX_PRODUCTION_PUBLIC_TOKEN=""
# Optional: leave these defaults unless you have custom published styles.
NEXT_PUBLIC_MAPBOX_STYLE_URL="mapbox://styles/mapbox/dark-v11"
NEXT_PUBLIC_MAPBOX_SATELLITE_STYLE_URL="mapbox://styles/mapbox/satellite-streets-v12"

# ── EMAIL: INVITATIONS, PASSWORD RESETS, APPROVAL NOTIFICATIONS ───────
# Obtain these from your email provider. Backend only.
SMTP_HOST=""
# Common values: 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# true for implicit TLS on 465; false for STARTTLS on 587.
SMTP_SECURE="false"
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="AEROLOG Operations"
# Comma-separated addresses explicitly approved for development test emails.
EMAIL_TEST_RECIPIENTS=""

# ── OPTIONAL PLANNING DETAILS ────────────────────────────────────────
# Informational only: these do not configure provider billing limits.
SERVICE_MONTHLY_BUDGET=""
SERVICE_BUDGET_CURRENCY="AED"
# Optional links to your operational templates / approved data providers.
OPERATIONS_TEMPLATES_URL=""
AIRSPACE_DATA_PROVIDER_URL=""
WEATHER_DATA_PROVIDER_URL=""

# ── DJI TEST ACCOUNT: SERVER-SIDE INTEGRATION TESTING ONLY ─────────────
# Use a dedicated test account where possible.
# Never expose these values in browser code, logs, exports, or Git.
# Credentials are for supported DJI authentication only; they do not grant API access.
# MFA, CAPTCHA, or account approval may still require your interaction.
# Keep values quoted. Prefer single quotes if a password contains $ or #.
DJI_TEST_ACCOUNT_USERNAME=""
DJI_TEST_ACCOUNT_PASSWORD=""

# Absolute path to the Python executable in your local .venv
DJI_PARSER_PYTHON=

# Created by npm run setup:local; development shortcuts are disabled in production.
AEROLOG_LOCAL_TEST_LOGIN="false"

# FlightHub 2 OpenAPI credentials (separate from the flight-record parsing key).
# Connector is pending; credentials alone do not enable synchronization.
DJI_FLIGHTHUB_ORGANIZATION_ID=
DJI_FLIGHTHUB_PROJECT_ID=
DJI_FLIGHTHUB_USER_TOKEN=
